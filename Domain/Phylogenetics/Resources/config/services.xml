<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="false" />

        <!-- Phylogenetics -->
        <service class="Amelaye\BioPHP\Domain\Phylogenetics\Service\NewickReader" id="amelaye_biophp.phylogenetics_newick_reader" />
        <service class="Amelaye\BioPHP\Domain\Phylogenetics\Service\NeighborJoiningTreeBuilder" id="amelaye_biophp.phylogenetics_neighbor_joining" />

        <service id="Amelaye\BioPHP\Domain\Phylogenetics\Interfaces\NewickReaderInterface" alias="amelaye_biophp.phylogenetics_newick_reader" />
        <service id="Amelaye\BioPHP\Domain\Phylogenetics\Interfaces\NeighborJoiningInterface" alias="amelaye_biophp.phylogenetics_neighbor_joining" />
    </services>

</container>
