<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="false" />

        <!-- Cloning -->
        <service class="Amelaye\BioPHP\Domain\Cloning\Service\CircularRestrictionDigestManager" id="amelaye_biophp.cloning_digest" />
        <service class="Amelaye\BioPHP\Domain\Cloning\Service\RestrictionEndCompatibilityManager" id="amelaye_biophp.cloning_end_compat" />
        <service class="Amelaye\BioPHP\Domain\Cloning\Service\GenbankPlasmidMapper" id="amelaye_biophp.cloning_genbank_mapper" />
        <service class="Amelaye\BioPHP\Domain\Cloning\Service\FeatureOverlapManager" id="amelaye_biophp.cloning_feature_overlap" />

        <service id="Amelaye\BioPHP\Domain\Cloning\Interfaces\RestrictionDigestInterface" alias="amelaye_biophp.cloning_digest" />
        <service id="Amelaye\BioPHP\Domain\Cloning\Interfaces\RestrictionEndCompatibilityInterface" alias="amelaye_biophp.cloning_end_compat" />
        <service id="Amelaye\BioPHP\Domain\Cloning\Interfaces\GenbankPlasmidMapperInterface" alias="amelaye_biophp.cloning_genbank_mapper" />
        <service id="Amelaye\BioPHP\Domain\Cloning\Interfaces\FeatureOverlapInterface" alias="amelaye_biophp.cloning_feature_overlap" />
    </services>

</container>
