<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="false" />

        <!-- Alignment -->
        <service class="Amelaye\BioPHP\Domain\Alignment\Service\NeedlemanWunschAligner" id="amelaye_biophp.alignment_needleman_wunsch" />
        <service class="Amelaye\BioPHP\Domain\Alignment\Service\SmithWatermanAligner" id="amelaye_biophp.alignment_smith_waterman" />
        <service class="Amelaye\BioPHP\Domain\Alignment\Service\SemiGlobalAligner" id="amelaye_biophp.alignment_semi_global" />
        <service class="Amelaye\BioPHP\Domain\Alignment\Service\SimpleMatchMismatchScoring" id="amelaye_biophp.alignment_simple_scoring" />
        <service class="Amelaye\BioPHP\Domain\Alignment\Service\Pam250Scoring" id="amelaye_biophp.alignment_pam250_scoring">
            <argument type="service" id="Amelaye\BioPHP\Api\Interfaces\Pam250MatrixDigitApiAdapter" />
        </service>

        <service id="Amelaye\BioPHP\Domain\Alignment\Interfaces\NeedlemanWunschAlignerInterface" alias="amelaye_biophp.alignment_needleman_wunsch" />
        <service id="Amelaye\BioPHP\Domain\Alignment\Interfaces\SmithWatermanAlignerInterface" alias="amelaye_biophp.alignment_smith_waterman" />
        <service id="Amelaye\BioPHP\Domain\Alignment\Interfaces\SemiGlobalAlignerInterface" alias="amelaye_biophp.alignment_semi_global" />
    </services>

</container>
