<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="false" />

        <!-- Variants -->
        <service class="Amelaye\BioPHP\Domain\Variants\Service\VcfReader" id="amelaye_biophp.variants_vcf_reader" />
        <service class="Amelaye\BioPHP\Domain\Variants\Service\VcfWriter" id="amelaye_biophp.variants_vcf_writer" />
        <service class="Amelaye\BioPHP\Domain\Variants\Service\VcfVariantRecordMapper" id="amelaye_biophp.variants_vcf_record_mapper" />

        <service id="Amelaye\BioPHP\Domain\Variants\Interfaces\VcfReaderInterface" alias="amelaye_biophp.variants_vcf_reader" />
        <service id="Amelaye\BioPHP\Domain\Variants\Interfaces\VcfWriterInterface" alias="amelaye_biophp.variants_vcf_writer" />
        <service id="Amelaye\BioPHP\Domain\Variants\Interfaces\VcfVariantRecordMapperInterface" alias="amelaye_biophp.variants_vcf_record_mapper" />
    </services>

</container>
